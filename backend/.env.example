# Porta da API
PORT=3000

# Conexão com o banco PostgreSQL
# Local:  postgresql://postgres:123@localhost:5432/gestao_clientes
# Supabase: use a connection string direta do projeto
DATABASE_URL=postgresql://postgres:123@localhost:5432/gestao_clientes

# Habilitar SSL na conexão com o banco (obrigatório no Supabase)
DB_SSL=false

# Segredo do JWT (troque em produção)
JWT_SECRET=seu-segredo-jwt-super-secreto
JWT_EXPIRES_IN=8h

# Consulta ao CNPJ (serviço externo publica.cnpj.ws)
# Timeout em ms por tentativa e quantidade de tentativas
CNPJ_WS_TIMEOUT_MS=10000
CNPJ_WS_TENTATIVAS=3

# Usuário admin inicial (criado pelo seed) - OBRIGATÓRIO
ADMIN_NOME=Administrador
ADMIN_EMAIL=seu-email@dominio.com
ADMIN_SENHA=sua-senha-forte-aqui
GCP_PROJECT_ID=
GCP_KEYFILE_PATH=

# BigQuery - Monitora Rondônia (OBRIGATÓRIO se usar o módulo)
BQ_VIEW_DOCUMENTOS=
BQ_TABLE_ENTRADAS=